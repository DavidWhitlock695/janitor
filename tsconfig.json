{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs", // Make sure this is set to "commonjs"
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true, // Add this line if it's not present
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020"],
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test"]
}
