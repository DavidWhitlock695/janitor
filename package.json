{
  "name": "janitor",
  "displayName": "Janitor",
  "description": "A VSCode plugin to hide Java annotations.",
  "version": "0.1.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onCommand:janitor.hideAnnotations"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "janitor.hideAnnotations",
        "title": "Hide Java Annotations"
      }
    ],
    "configuration": {
      "type": "object",
      "properties": {
        "janitor.hideAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Hide Java annotations in the editor."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "typescript": "^4.4.3",
    "vscode": "^1.60.0",
    "eslint": "^7.32.0",
    "mocha": "^9.1.3",
    "chai": "^4.3.4"
  }
}